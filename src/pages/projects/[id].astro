---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} — Monir.dev`} description={project.data.description}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <!-- Back -->
    <a href="/projects" class="inline-flex items-center gap-2 text-sm text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors mb-10">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to Projects
    </a>

    <!-- Header -->
    <header class="animate-on-scroll mb-10">
      <div class="flex items-start justify-between gap-4 mb-6">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white text-2xl shadow-lg shadow-indigo-500/30 shrink-0">
          🛠️
        </div>
        <div class="flex gap-2 mt-1">
          {project.data.github && (
            <a href={project.data.github} target="_blank" rel="noopener" class="btn-ghost text-sm py-2 px-4">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
              GitHub
            </a>
          )}
          {project.data.demo && (
            <a href={project.data.demo} target="_blank" rel="noopener" class="btn-primary text-sm py-2 px-4">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              Live Demo
            </a>
          )}
        </div>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold mb-4 leading-tight">{project.data.title}</h1>
      <p class="text-[var(--text-muted)] text-base sm:text-lg mb-6">{project.data.description}</p>

      <div class="flex flex-wrap gap-2">
        {project.data.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    </header>

    <div class="h-px bg-gradient-to-r from-transparent via-[var(--surface-border)] to-transparent mb-10"></div>

    <!-- Content -->
    <div class="prose-custom animate-on-scroll">
      <Content />
    </div>

    <div class="mt-16 pt-8 border-t border-[var(--surface-border)]">
      <a href="/projects" class="btn-ghost">← Back to all projects</a>
    </div>
  </article>
</Layout>
